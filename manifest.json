{
  "manifest_version": 3,
  "name": "BTC Price Badge",
  "version": "1.0.0",
  "description": "Shows the live Bitcoin price on the toolbar icon.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://api.coingecko.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BTC Price",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
